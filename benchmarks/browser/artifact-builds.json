    }
  },
  "builds": {
    "prettyM": {
      "example": {
        "id": "prettyM",
        "variant": "default"
      },
      "artifactSet": {
        "setId": "prettyM-bounded-set-0007",
        "benchmarkContract": {
          "id": "prettyM/artifacts/v1",
          "input": "prettyM-compact-format/v1",
          "output": "prettyM-text-and-complete-style-events/v1",
          "timingPhases": ["prepare", "execute", "decode", "render"]
        }
      },
      "checkouts": {
        "fir": "fir-prettyM-extended",
        "fir-current": "fir-prettyM-current",
        "lean": "lean-4.33.0",
        "vir": "vir-prettyM",
        "workload": "prettyM-workload",
        "workload-flat": "prettyM-flat-workload"
      },
      "components": {
        "vir": {
          "artifact": {
            "boundary": "browser-benchmarks/bounded-runtime/v1",
            "lean": {
              "version": "4.33.0",
              "commit": "d8b18978322de05a8f3dba51ef03cf5461676c17"
            },
            "runtime": {
              "pipeline": "lean-vir-ir-interpreter-wasm32-wasip1",
              "sourceRef": "vir-prettyM",
              "sourceDirty": false,
              "wasiSdk": "33.0"
            },
            "workload": {
              "file": "prettyM-vir.irpkg",
              "packageRef": "prettyM",
              "packageFormat": 10,
              "manifestVersion": 7,
              "source": {
                "sourceRef": "prettyM-workload",
                "dirty": false
              }
            }
          },
          "producer": {
            "protocol": "browser-benchmarks/source-package/v1",
            "adapter": "vir",
            "checkouts": {
              "producer": "vir",
              "runtime": "lean",
              "workload": "workload"
            },
            "files": {
              "prettyM-vir.irpkg": "prettyM/prettyM-vir.irpkg",
              "lean-vir/js/vir-runtime.js": "prettyM/lean-vir/js/vir-runtime.js",
              "lean-vir/wasm/vir-upstream.wasm": "prettyM/lean-vir/wasm/vir-upstream.wasm"
            }
          }
        },
        "native": {
          "artifact": {
            "boundary": "browser-benchmarks/bounded-runtime/v1",
            "lean": {
              "version": "4.32.0",
              "commit": "8c9756b28d64dab099da31a4c09229a9e6a2ef35"
            }
          },
          "producer": {
            "protocol": "browser-benchmarks/source-package/v1",
            "adapter": "fir-native",
            "checkouts": {
              "producer": "fir"
            },
            "entrypoint": "integration/talos/artifact/package-pretty-format.sh",
            "manifest": "BUILD.json",
            "files": {
              "BUILD.json": "prettyM/lean-native/BUILD.json",
              "prettyM-browser-adapter.mjs": "prettyM/lean-native/prettyM-browser-adapter.mjs",
              "prettyM.wasm": "prettyM/lean-native/prettyM.wasm",
              "prettyM.wasm.json": "prettyM/lean-native/prettyM.wasm.json"
            }
          }
        },
        "native-flat": {
          "artifact": {
            "boundary": "browser-benchmarks/bounded-runtime/v1",
            "lean": {
              "version": "4.33.0",
              "commit": "d8b18978322de05a8f3dba51ef03cf5461676c17"
            }
          },
          "producer": {
            "protocol": "browser-benchmarks/source-package/v1",
            "adapter": "fir-native",
            "checkouts": {
              "producer": "fir-current",
              "workload": "workload-flat"
            },
            "setup": [
              {
                "checkout": "workload",
                "command": "git",
                "args": [
                  "fetch",
                  "--no-tags",
                  "origin",
                  "refs/heads/upgrade/fir-html-lean-4.33:refs/remotes/ejgallego/upgrade/fir-html-lean-4.33"
                ]
              }
            ],
            "entrypoint": "integration/verso-flat/check.sh",
            "packagePath": "integration/verso-flat/_build/verso-flat-current",
            "manifest": "BUILD.json",
            "files": {
              "BUILD.json": "prettyM/lean-native-flat/BUILD.json",
              "SHA256SUMS": "prettyM/lean-native-flat/SHA256SUMS",
              "prettyM-browser-adapter.mjs": "prettyM/lean-native-flat/prettyM-browser-adapter.mjs",
              "prettyM.wasm": "prettyM/lean-native-flat/prettyM.wasm",
              "prettyM.wasm.json": "prettyM/lean-native-flat/prettyM.wasm.json",
              "smoke.mjs": "prettyM/lean-native-flat/smoke.mjs"
            }
          }
        },
        "llvm": {
          "dependencies": ["native"],
          "artifact": {
            "boundary": "browser-benchmarks/bounded-runtime/v1",
            "lean": {
              "version": "4.32.0",
              "commit": "8c9756b28d64dab099da31a4c09229a9e6a2ef35"
            }
          },
          "producer": {
            "protocol": "browser-benchmarks/source-package/v1",
            "adapter": "fir-llvm",
            "checkouts": {
              "producer": "fir"
            },
            "setup": [
              {
                "checkout": "producer",
                "command": "bash",
                "args": ["integration/lcnf-c-wasm/setup-emscripten.sh"]
              }
            ],
            "entrypoint": "integration/lcnf-c-wasm/package-prettyM-emscripten.sh",
            "manifest": "prettyM.manifest.json",
            "files": {
              "README.md": "prettyM/lean-llvm/README.md",
              "SHA256SUMS": "prettyM/lean-llvm/SHA256SUMS",
              "emscripten-loader.mjs": "prettyM/lean-llvm/emscripten-loader.mjs",
              "prettyM-emscripten-adapter.mjs": "prettyM/lean-llvm/prettyM-emscripten-adapter.mjs",
              "prettyM.manifest.json": "prettyM/lean-llvm/prettyM.manifest.json",
              "prettyM.mjs": "prettyM/lean-llvm/prettyM.mjs",
              "prettyM.wasm": "prettyM/lean-llvm/prettyM.wasm"
            }
          }
        }
      }
    },
    "prettyM-html": {
