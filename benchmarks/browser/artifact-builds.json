{
  "schemaVersion": 2,
  "kind": "browser-benchmarks/artifact-build-catalog",
  "sources": {
    "fir-prettyM": {
      "kind": "git",
      "repository": "https://github.com/ejgallego/lean-fir",
      "revision": "298682a766d80e90053d3e76ee2f3e4af78a52aa"
    },
    "fir-lean-zip": {
      "kind": "git",
      "repository": "https://github.com/ejgallego/lean-fir",
      "revision": "b9f6adb4e6e0bf3262e66d16d33b45223e1960b1"
    },
    "lean-4.33.0": {
      "kind": "git",
      "repository": "https://github.com/leanprover/lean4",
      "revision": "d8b18978322de05a8f3dba51ef03cf5461676c17"
    },
    "prettyM-workload": {
      "kind": "git",
      "repository": "https://github.com/leanprover/verso-slides",
      "revision": "c16a6f83b622dd8ebc2f4975d93b856b08dde444"
    },
    "lean-zip-browser": {
      "kind": "git",
      "repository": "https://github.com/ejgallego/lean-zip",
      "revision": "273d0d6cd9cab77c7f3489b0b0b1f6e543315d21"
    },
    "lean-zip-common": {
      "kind": "git",
      "repository": "https://github.com/kim-em/lean-zip-common",
      "revision": "4425bab1f9522307d77e8d485bc536149ba31c36"
    },
    "vir-lean-zip": {
      "kind": "git",
      "repository": "https://github.com/ejgallego/lean-vir",
      "revision": "6259590afa7ba2550b10908c9a6448d5eac21d86"
    },
    "vir-prettyM": {
      "kind": "git",
      "repository": "https://github.com/ejgallego/lean-vir",
      "revision": "267fb65dc7a020e77ca60c2a020c1cf3bc3faf65"
    }
  },
  "builds": {
    "prettyM": {
      "example": {
        "id": "prettyM",
        "variant": "default"
      },
      "artifactSet": {
        "setId": "prettyM-bounded-set-0002",
        "benchmarkContract": {
          "id": "prettyM/artifacts/v1",
          "input": "prettyM-compact-format/v1",
          "output": "prettyM-text-and-complete-style-events/v1",
          "timingPhases": ["prepare", "execute", "decode", "render"]
        }
      },
      "checkouts": {
        "fir": "fir-prettyM",
        "lean": "lean-4.33.0",
        "vir": "vir-prettyM",
        "workload": "prettyM-workload"
      },
      "components": {
        "vir": {
          "artifact": {
            "boundary": "browser-benchmarks/bounded-runtime/v1",
            "lean": {
              "version": "4.33.0",
              "commit": "d8b18978322de05a8f3dba51ef03cf5461676c17"
            },
            "runtime": {
              "pipeline": "lean-vir-ir-interpreter-wasm32-wasip1",
              "sourceRef": "vir-prettyM",
              "sourceDirty": false,
              "wasiSdk": "33.0"
            },
            "workload": {
              "file": "prettyM-vir.irpkg",
              "packageRef": "prettyM",
              "packageFormat": 10,
              "manifestVersion": 7,
              "source": {
                "sourceRef": "prettyM-workload",
                "dirty": false
              }
            }
          },
          "producer": {
            "protocol": "browser-benchmarks/source-package/v1",
            "adapter": "vir",
            "checkouts": {
              "producer": "vir",
              "runtime": "lean",
              "workload": "workload"
            },
            "files": {
              "prettyM-vir.irpkg": "prettyM/prettyM-vir.irpkg",
              "lean-vir/js/vir-runtime.js": "prettyM/lean-vir/js/vir-runtime.js",
              "lean-vir/wasm/vir-upstream.wasm": "prettyM/lean-vir/wasm/vir-upstream.wasm"
            }
          }
        },
        "native": {
          "artifact": {
            "boundary": "browser-benchmarks/bounded-runtime/v1",
            "lean": {
              "version": "4.32.0",
              "commit": "8c9756b28d64dab099da31a4c09229a9e6a2ef35"
            }
          },
          "producer": {
            "protocol": "browser-benchmarks/source-package/v1",
            "adapter": "fir-native",
            "checkouts": {
              "producer": "fir"
            },
            "entrypoint": "integration/talos/artifact/package-pretty-format.sh",
            "manifest": "BUILD.json",
            "files": {
              "BUILD.json": "prettyM/lean-native/BUILD.json",
              "prettyM-browser-adapter.mjs": "prettyM/lean-native/prettyM-browser-adapter.mjs",
              "prettyM.wasm": "prettyM/lean-native/prettyM.wasm",
              "prettyM.wasm.json": "prettyM/lean-native/prettyM.wasm.json"
            }
          }
        },
        "llvm": {
          "dependencies": ["native"],
          "artifact": {
            "boundary": "browser-benchmarks/bounded-runtime/v1",
            "lean": {
              "version": "4.32.0",
              "commit": "8c9756b28d64dab099da31a4c09229a9e6a2ef35"
            }
          },
          "producer": {
            "protocol": "browser-benchmarks/source-package/v1",
            "adapter": "fir-llvm",
            "checkouts": {
              "producer": "fir"
            },
            "setup": [
              {
                "checkout": "producer",
                "command": "bash",
                "args": ["integration/lcnf-c-wasm/setup-emscripten.sh"]
              }
            ],
            "entrypoint": "integration/lcnf-c-wasm/package-prettyM-emscripten.sh",
            "manifest": "prettyM.manifest.json",
            "files": {
              "README.md": "prettyM/lean-llvm/README.md",
              "SHA256SUMS": "prettyM/lean-llvm/SHA256SUMS",
              "emscripten-loader.mjs": "prettyM/lean-llvm/emscripten-loader.mjs",
              "prettyM-emscripten-adapter.mjs": "prettyM/lean-llvm/prettyM-emscripten-adapter.mjs",
              "prettyM.manifest.json": "prettyM/lean-llvm/prettyM.manifest.json",
              "prettyM.mjs": "prettyM/lean-llvm/prettyM.mjs",
              "prettyM.wasm": "prettyM/lean-llvm/prettyM.wasm"
            }
          }
        }
      }
    },
    "lean-zip": {
      "example": {
        "id": "lean-zip",
        "variant": "default"
      },
      "artifactSet": {
        "setId": "lean-zip-browser-set-0001",
        "benchmarkContract": {
          "id": "lean-zip/raw-deflate/v1",
          "input": "byte-array-and-compression-level/v1",
          "output": "raw-deflate-byte-array/v1",
          "timingPhases": ["prepare", "first-call", "steady"]
        }
      },
      "checkouts": {
        "fir": "fir-lean-zip",
        "lean": "lean-4.33.0",
        "lean-zip": "lean-zip-browser",
        "vir": "vir-lean-zip",
        "zip-common": "lean-zip-common"
      },
      "components": {
        "workload": {
          "artifact": {
            "boundary": "browser-benchmarks/bounded-runtime/v1",
            "contract": "lean-zip/browser-benchmark-source/v1",
            "oracle": "native-lean-build-time"
          },
          "producer": {
            "protocol": "browser-benchmarks/source-package/v1",
            "adapter": "package-command",
            "checkouts": {
              "producer": "lean-zip"
            },
            "entrypoint": "bench/catalog/export-browser-benchmark-source.mjs",
            "manifest": "BUILD.json",
            "setup": [
              {
                "checkout": "producer",
                "command": "npm",
                "args": ["--prefix", "bench/web", "ci"]
              }
            ],
            "files": {
              "BUILD.json": "lean-zip/workload/BUILD.json",
              "SHA256SUMS": "lean-zip/workload/SHA256SUMS",
              "smoke.mjs": "lean-zip/workload/smoke.mjs",
              "workload/backend-worker.mjs": "lean-zip/workload/backend-worker.mjs",
              "workload/catalog-controller.mjs": "lean-zip/workload/catalog-controller.mjs",
              "workload/fflate.mjs": "lean-zip/workload/fflate.mjs",
              "workload/native-oracle.json": "lean-zip/workload/native-oracle.json",
              "workload/plan.json": "lean-zip/workload/plan.json",
              "workload/protocol.mjs": "lean-zip/workload/protocol.mjs",
              "workload/vectors/random-4k.input.bin": "lean-zip/workload/vectors/random-4k.input.bin",
              "workload/vectors/random-4k.level-1.raw": "lean-zip/workload/vectors/random-4k.level-1.raw",
              "workload/vectors/random-4k.level-6.raw": "lean-zip/workload/vectors/random-4k.level-6.raw",
              "workload/vectors/repeated-1k.input.bin": "lean-zip/workload/vectors/repeated-1k.input.bin",
              "workload/vectors/repeated-1k.level-1.raw": "lean-zip/workload/vectors/repeated-1k.level-1.raw",
              "workload/vectors/repeated-1k.level-6.raw": "lean-zip/workload/vectors/repeated-1k.level-6.raw",
              "workload/vectors/structured-16k.input.bin": "lean-zip/workload/vectors/structured-16k.input.bin",
              "workload/vectors/structured-16k.level-1.raw": "lean-zip/workload/vectors/structured-16k.level-1.raw",
              "workload/vectors/structured-16k.level-10.raw": "lean-zip/workload/vectors/structured-16k.level-10.raw",
              "workload/vectors/structured-16k.level-6.raw": "lean-zip/workload/vectors/structured-16k.level-6.raw"
            }
          }
        },
        "vir": {
          "dependencies": ["workload"],
          "artifact": {
            "boundary": "browser-benchmarks/bounded-runtime/v1",
            "compilerRoute": "lean-vir-ir-interpreter-wasm32-wasip1",
            "entry": "VirLeanZipAcceptance.compressRaw"
          },
          "producer": {
            "protocol": "browser-benchmarks/source-package/v1",
            "adapter": "package-command",
            "checkouts": {
              "client": "lean-zip",
              "producer": "vir",
              "runtime": "lean"
            },
            "entrypoint": "scripts/export-lean-zip-browser-package.mjs",
            "manifest": "BUILD.json",
            "setup": [
              {
                "checkout": "producer",
                "command": "npm",
                "args": ["ci"]
              },
              {
                "checkout": "producer",
                "command": "npm",
                "args": ["run", "install:wasi"]
              }
            ],
            "files": {
              "BUILD.json": "lean-zip/vir/BUILD.json",
              "SHA256SUMS": "lean-zip/vir/SHA256SUMS",
              "lean-vir/js/vir-runtime.js": "lean-zip/vir/lean-vir/js/vir-runtime.js",
              "lean-vir/wasm/vir-upstream.wasm": "lean-zip/vir/lean-vir/wasm/vir-upstream.wasm",
              "lean-zip.irpkg": "lean-zip/vir/lean-zip.irpkg",
              "smoke.expected.raw": "lean-zip/vir/smoke.expected.raw",
              "smoke.input.bin": "lean-zip/vir/smoke.input.bin",
              "smoke.mjs": "lean-zip/vir/smoke.mjs"
            }
          }
        },
        "fir-native": {
          "artifact": {
            "boundary": "browser-benchmarks/bounded-runtime/v1",
            "compilerRoute": "fir-resident-zero-import",
            "runtimeContract": "fir.standard-libm/v2"
          },
          "producer": {
            "protocol": "browser-benchmarks/source-package/v1",
            "adapter": "package-command",
            "checkouts": {
              "client": "lean-zip",
              "producer": "fir",
              "zip-common": "zip-common"
            },
            "entrypoint": "integration/lean-zip/export-raw-package.mjs",
            "manifest": "BUILD.json",
            "setup": [
              {
                "checkout": "producer",
                "command": "bash",
                "args": ["integration/lcnf-c-wasm/setup-emscripten.sh"]
              }
            ],
            "files": {
              "BUILD.json": "lean-zip/fir-native/BUILD.json",
              "SHA256SUMS": "lean-zip/fir-native/SHA256SUMS",
              "lean-zip-byte-array-browser-adapter.mjs": "lean-zip/fir-native/lean-zip-byte-array-browser-adapter.mjs",
              "lean-zip-raw-browser-adapter.mjs": "lean-zip/fir-native/lean-zip-raw-browser-adapter.mjs",
              "lean-zip-raw.wasm": "lean-zip/fir-native/lean-zip-raw.wasm",
              "lean-zip-raw.wasm.functions.json": "lean-zip/fir-native/lean-zip-raw.wasm.functions.json",
              "lean-zip-raw.wasm.json": "lean-zip/fir-native/lean-zip-raw.wasm.json",
              "smoke.mjs": "lean-zip/fir-native/smoke.mjs",
              "standard-libm-runtime-contract.mjs": "lean-zip/fir-native/standard-libm-runtime-contract.mjs"
            }
          }
        },
        "fir-emscripten": {
          "artifact": {
            "boundary": "browser-benchmarks/bounded-runtime/v1",
            "compilerRoute": "final-lcnf-lean-c-llvm-emscripten",
            "runtime": "full-lean"
          },
          "producer": {
            "protocol": "browser-benchmarks/source-package/v1",
            "adapter": "package-command",
            "checkouts": {
              "fir": "fir",
              "producer": "lean-zip",
              "zip-common": "zip-common"
            },
            "entrypoint": "bench/fir-c/package.mjs",
            "manifest": "BUILD.json",
            "setup": [
              {
                "checkout": "fir",
                "command": "bash",
                "args": ["integration/lcnf-c-wasm/setup-emscripten.sh"]
              }
            ],
            "files": {
              "BUILD.json": "lean-zip/fir-emscripten/BUILD.json",
              "SHA256SUMS": "lean-zip/fir-emscripten/SHA256SUMS",
              "emscripten-loader.mjs": "lean-zip/fir-emscripten/emscripten-loader.mjs",
              "lean-zip-emscripten-adapter.mjs": "lean-zip/fir-emscripten/lean-zip-emscripten-adapter.mjs",
              "lean-zip-emscripten.manifest.json": "lean-zip/fir-emscripten/lean-zip-emscripten.manifest.json",
              "lean-zip-emscripten.mjs": "lean-zip/fir-emscripten/lean-zip-emscripten.mjs",
              "lean-zip-emscripten.wasm": "lean-zip/fir-emscripten/lean-zip-emscripten.wasm",
              "smoke.mjs": "lean-zip/fir-emscripten/smoke.mjs"
            }
          }
        }
      }
    }
  }
}
