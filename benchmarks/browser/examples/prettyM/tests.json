{
  "schemaVersion": 1,
  "kind": "browser-benchmarks/example-tests",
  "example": "prettyM",
  "variants": [
    {
      "id": "default",
      "title": "Compact Format to styled segments",
      "build": "prettyM",
      "tests": [
        {
          "id": "smoke-parity",
          "study": "smoke",
          "oracle": "js",
          "backends": ["js", "vir-format", "native", "native-flat", "llvm"],
          "data": {
            "scenarios": [
              {
                "case": {
                  "id": "webapp-smoke",
                  "label": "Webapp smoke",
                  "format": [5, [4, "hello", [4, 1, "world"]]],
                  "origin": "example-package"
                },
                "width": 8
              }
            ]
          }
        }
      ],
      "benchmark": {
        "study": "suite",
        "data": {
          "studies": [
            "differential",
            "scaling",
            "memory-retained",
            "interactions",
            "repeated"
          ]
        }
      }
    },
    {
      "id": "html",
      "title": "Complete escaped HTML and live DOM rendering",
      "build": "prettyM-html",
      "tests": [
        {
          "id": "html-smoke-parity",
          "study": "smoke",
          "oracle": "js-html",
          "backends": ["js-html", "vir-html", "native-html", "llvm-html"],
          "data": {
            "scenarios": [
              {
                "case": {
                  "id": "html-smoke",
                  "label": "Tags and escaping",
                  "origin": "example-package",
                  "format": [7, 5, [4, "Lean <&\"", [4, 1, "Wasm"]]]
                },
                "width": 8
              }
            ]
          }
        }
      ],
      "benchmark": {
        "study": "suite",
        "data": {
          "studies": ["differential", "scaling", "repeated", "live-render"]
        }
      }
    }
  ]
}
