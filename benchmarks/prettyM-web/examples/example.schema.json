{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "browser-benchmarks/example/v1",
  "title": "Lean browser benchmark example",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "title",
    "summary",
    "lifecycle",
    "packages",
    "controller",
    "testPackage"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "browser-benchmarks/example" },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "lifecycle": {
      "enum": ["active", "candidate", "rehearsal", "queued", "archived"]
    },
    "controller": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\).+\\.mjs$"
    },
    "testPackage": {
      "type": "string",
      "pattern": "^examples/[a-zA-Z0-9][a-zA-Z0-9._-]*/tests\\.json$"
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "target", "exports"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "target": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\).+\\.lean$"
          },
          "exports": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
