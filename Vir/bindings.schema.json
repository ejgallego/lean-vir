{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leanprover.github.io/lean-vir/schemas/binding-library-v1.json",
  "title": "Lean VIR binding library",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "title", "description", "lean", "roots"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "lean": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modules"],
      "properties": {
        "modules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "generation": { "$ref": "#/$defs/generation" },
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/root" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output", "irOutput", "imports", "namespace", "abiProfile", "resources", "members"],
      "properties": {
        "output": { "type": "string", "minLength": 1 },
        "irOutput": { "type": "string", "minLength": 1 },
        "imports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "namespace": { "type": "string", "minLength": 1 },
        "abiProfile": { "$ref": "#/$defs/abiProfile" },
        "resources": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "methodPolicies": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/methodPolicy" }
        },
        "exceptions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/generationException" }
        }
      }
    },
    "methodPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signature"],
      "properties": {
        "signature": {
          "oneOf": [
            { "const": "only" },
            { "type": "integer", "minimum": 0 }
          ]
        },
        "omittedOptionalParameters": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "abiProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "effect", "types", "resource", "receiver"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "effect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "lean"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "lean": { "type": "string", "minLength": 1 }
          }
        },
        "types": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lean", "representation"],
            "properties": {
              "lean": { "type": "string", "minLength": 1 },
              "representation": { "enum": ["immediate", "js-resource"] }
            }
          }
        },
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "required": ["constructor", "nullableConstructor", "argument", "result"],
          "properties": {
            "constructor": { "type": "string", "minLength": 1 },
            "nullableConstructor": { "type": "string", "minLength": 1 },
            "argument": { "$ref": "#/$defs/passingRetention" },
            "result": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ownership"],
              "properties": { "ownership": { "enum": ["owned", "borrowed"] } }
            }
          }
        },
        "receiver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default", "globalTypes"],
          "properties": {
            "default": { "$ref": "#/$defs/passingRetention" },
            "globalTypes": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "passingRetention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passing", "retention"],
      "properties": {
        "passing": { "enum": ["borrowed", "owned", "consumed"] },
        "retention": { "enum": ["call", "until-release", "runtime"] }
      }
    },
    "modalityOverride": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "passing": { "enum": ["borrowed", "owned", "consumed"] },
        "retention": { "enum": ["call", "until-release", "runtime"] }
      }
    },
    "receiverOverride": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["global", "argument"] },
        "passing": { "enum": ["borrowed", "owned", "consumed"] },
        "retention": { "enum": ["call", "until-release", "runtime"] }
      }
    },
    "generationException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "anyOf": [
        { "required": ["receiver"] },
        { "required": ["arguments"] },
        { "required": ["result"] },
        { "required": ["effect"] }
      ],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "receiver": { "$ref": "#/$defs/receiverOverride" },
        "arguments": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/modalityOverride" }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ownership"],
          "properties": { "ownership": { "enum": ["owned", "borrowed"] } }
        },
        "effect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "lean"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "lean": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "manualException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "targets", "upstream"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "^[^*]*(?:\\*)?$" }
        },
        "lean": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "public": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "upstream": { "$ref": "#/$defs/upstream" },
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": ["report"],
          "properties": {
            "report": { "type": "string", "minLength": 1 }
          }
        },
        "mappings": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/directMapping" },
              { "$ref": "#/$defs/propertyMapping" }
            ]
          }
        },
        "anchors": {
          "type": "array",
          "items": { "$ref": "#/$defs/anchor" }
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lean", "ts", "relation", "portIntent"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "lean": { "type": "string", "minLength": 1 },
        "ts": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "relation": { "enum": ["audit", "coverageGap"] },
        "portIntent": { "$ref": "#/$defs/portIntent" },
        "note": { "type": "string", "minLength": 1 },
        "advisorySemantics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/advisorySemantic" }
        }
      }
    },
    "portIntent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["disposition"],
          "properties": { "disposition": { "const": "unsupported" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["disposition"],
          "properties": {
            "disposition": { "const": "bind" },
            "accessor": { "enum": ["get", "set"] },
            "effect": { "type": "string", "minLength": 1 },
            "omittedOptionalParameters": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "overload": { "type": "integer", "minimum": 0 },
            "receiver": { "enum": ["borrowed", "owned", "consumed"] },
            "representation": { "const": "hostResource" },
            "resourceArguments": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 0 }
            },
            "resultRepresentation": { "const": "hostResource" }
          }
        }
      ]
    },
    "advisorySemantic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "note"],
      "properties": {
        "topic": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "directMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typescript", "targets"],
      "properties": {
        "typescript": { "type": "string", "minLength": 1 },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "lean": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "note": { "type": "string", "minLength": 1 },
        "manualException": { "$ref": "#/$defs/manualException" }
      }
    },
    "propertyMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typescript", "accessors"],
      "properties": {
        "typescript": { "type": "string", "minLength": 1 },
        "accessors": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "get": { "$ref": "#/$defs/accessorOperation" },
            "set": { "$ref": "#/$defs/accessorOperation" }
          }
        },
        "note": { "type": "string", "minLength": 1 },
        "manualException": { "$ref": "#/$defs/manualException" }
      }
    },
    "accessorOperation": {
      "oneOf": [
        { "$ref": "#/$defs/accessorMapping" },
        { "$ref": "#/$defs/missingAccessor" }
      ]
    },
    "accessorMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "lean", "anchor"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "lean": { "type": "string", "minLength": 1 },
        "anchor": { "type": "string", "minLength": 1 }
      }
    },
    "missingAccessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missing", "note"],
      "properties": {
        "missing": { "const": true },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "typescript" } },
            "required": ["kind"]
          },
          "then": { "required": ["declarations", "roots"] }
        },
        {
          "if": { "required": ["sourceUrl"] },
          "then": { "properties": { "declarations": { "type": "array", "maxItems": 1 } } }
        }
      ],
      "properties": {
        "kind": { "enum": ["typescript", "local", "internal"] },
        "package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "declarations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "sourceUrl": { "type": "string", "minLength": 1 },
        "roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "dependencyDepth": { "type": "integer", "minimum": 0 },
        "dependencyPolicy": {
          "type": "array",
          "items": { "$ref": "#/$defs/dependencyPolicySymbol" }
        },
        "docs": { "type": "string", "minLength": 1 }
      }
    },
    "dependencyPolicySymbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "shape"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "display": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "shape": { "type": "object" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "startLine", "startColumn", "endLine", "endColumn"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "startLine": { "type": "integer", "minimum": 1 },
            "startColumn": { "type": "integer", "minimum": 1 },
            "endLine": { "type": "integer", "minimum": 1 },
            "endColumn": { "type": "integer", "minimum": 1 },
            "url": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
