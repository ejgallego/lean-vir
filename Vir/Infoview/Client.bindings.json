        "reason": "Assigns the exact native AbortSignal to options.abortSignal without wrapping the signal or changing cancellation behavior.",
        "upstreamRelation": { "kind": "upstream-adapter", "member": "ClientRequestOptions.abortSignal", "semantics": "preserving" },
