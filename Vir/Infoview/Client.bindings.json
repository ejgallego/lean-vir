        "lean": "Lean.Vir.Infoview.RpcSession.callWithOptions", "marker": "vir_js",
        "reason": "Passes the exact ClientRequestOptions and AbortSignal to the position-specific session; params use Js.Any to fit the interpreter arity limit without changing their value. Cancellation and Promise settlement follow the official RPC client and server.",
        "upstreamRelation": { "kind": "upstream-adapter", "member": "RpcSessionAtPos.call", "semantics": "preserving" },
